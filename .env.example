# System Execution Environment (development | staging | production)
ENVIRONMENT=development

# Application Configuration
APP_NAME=NIDS-Platform
APP_VERSION=2.0.0-DRAFT
DEBUG=true
LOG_LEVEL=INFO

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 15)
POSTGRES_USER=nids_user
POSTGRES_PASSWORD=nids_password
POSTGRES_DB=nids_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nids_user:nids_password@postgres:5432/nids_db

# Redis Configuration (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
